{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": true,
    "target": "ES2022",
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@assets/*": ["./assets/*"],
      "@pages/*": ["./src/renderer/pages/*"],
      "@components/*": ["./src/renderer/components/*"],
      "@common/*": ["./src/common/*"],
      "@main/*": ["./src/main/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@src/*": ["./src/*"],
      "@misc/*": ["./misc/*"]
    }
  },
  "include": ["src/**/*", "tools/**/*"]
}
